# Portainer stack variables. Use a dedicated database and role on the existing instance.
PUBLIC_BASE_URL=https://kanvas.kelli.photo
DATABASE_CONNECTION=Host=postgres;Port=5432;Database=kellikanvas;Username=kellikanvas_app;Password=replace-me
POSTGRES_NETWORK=postgres-network
WORKOS_CLIENT_ID=client_replace_me
WORKOS_API_KEY=sk_replace_me
WORKOS_ORGANIZATION_ID=
# Optional comma-separated verified email allowlist for a private family deployment.
ALLOWED_EMAILS=
# Generate once: openssl rand -base64 32. Keep with backups; losing it loses saved connections.
CONNECTION_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# Trust only the Docker subnet used by the host nginx ingress, if forwarded client IPs are needed.
TRUSTED_PROXY_CIDRS=
SERVER_PORT=6080
SERVER_IMAGE=ghcr.io/jedon/kellikanvas-server:latest
