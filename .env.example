# Copy to repo-root .env or set as environment variables before assembling.
# Never commit real values. NAS login is entered at runtime from the phone pairing form.

# QNAP deployment tooling only; these are never embedded in the APK.
QNAP_NAS_USERNAME=
QNAP_NAS_PASSWORD=
QNAP_NAS_HOST=192.168.68.81

# Google Photos TV OAuth client (see docs/google-sources.md)
KELLIKANVAS_GOOGLE_TV_CLIENT_ID=
KELLIKANVAS_GOOGLE_TV_CLIENT_SECRET=

# Release metadata pin (existing)
# KELLIKANVAS_METADATA_PUBLIC_KEY_BASE64=

# Hosted account server (public URL; no server credentials in the APK).
KELLIKANVAS_SERVER_URL=https://kanvas.kelli.photo
